# =============================
# SAP WRITE ENVIRONMENT
# =============================
# Guardia exclusiva para escrituras. Valores: QA o PROD.
SAP_ENVIRONMENT=QA

# =============================
# TERRAMAR - DI API / Service Layer WRITE
# =============================
# QA: TESTTERRACHILE | PROD: SBOTERRACHILE
SAP_TERRAMAR_COMPANY_DB=TESTTERRACHILE
SAP_TERRAMAR_SERVER=COLOCAR_SERVIDOR_DI_TERRAMAR
SAP_TERRAMAR_DB_SERVER_TYPE=9
SAP_TERRAMAR_USE_TRUSTED=False
SAP_TERRAMAR_USER=COLOCAR_USUARIO_DI_TERRAMAR
SAP_TERRAMAR_PASSWORD=COLOCAR_PASSWORD_DI_TERRAMAR
SAP_TERRAMAR_PROFORMA_SERIES=79

# =============================
# SBH - DI API / Service Layer WRITE
# =============================
# QA: SBO_TST_SBH_USD | PROD: SBO_SBH_USD
SAP_SBH_COMPANY_DB=SBO_TST_SBH_USD
SAP_SBH_SERVER=COLOCAR_SERVIDOR_DI_SBH
SAP_SBH_DB_SERVER_TYPE=9
SAP_SBH_USE_TRUSTED=False
SAP_SBH_USER=COLOCAR_USUARIO_DI_SBH
SAP_SBH_PASSWORD=COLOCAR_PASSWORD_DI_SBH
SAP_SBH_PROFORMA_SERIES=1

# =============================
# SERVICE LAYER WRITE/READ
# =============================
# CompanyDB se elige por empresa desde SAP_TERRAMAR_COMPANY_DB / SAP_SBH_COMPANY_DB.
SAP_SL_BASE_URL=COLOCAR_URL_SERVICE_LAYER
SAP_SL_USERNAME=COLOCAR_USUARIO_SERVICE_LAYER
SAP_SL_PASSWORD=COLOCAR_PASSWORD_SERVICE_LAYER
SAP_SL_VERIFY_SSL=True
SAP_SL_TIMEOUT=30
# Legacy exclusivo para scripts diagnosticos sin empresa; no usar en flujos operacionales.
SAP_SL_COMPANY_DB=COLOCAR_COMPANY_DB_SOLO_DIAGNOSTICO

# Segunda defensa legacy exclusiva del envio QA de recepcion.
SAP_DRAFT_QA_COMPANY_DB=COLOCAR_COMPANY_DB_QA_ESPERADA
SAP_GOODS_RECEIPT_DRAFT_SERIES=17
SAP_GOODS_RECEIPT_DRAFT_OBJECT_CODE=oPurchaseDeliveryNotes

# Preview diagnostico de despacho: LOCAL/QA=true, PRODUCCION=false.
# Solo habilita lectura y calculo; no controla el PATCH real.
SAP_DESPACHO_PREVIEW_ENABLED=false

# Solo habilita lectura y cálculo del preview de Recepción.
# No controla el envío real del Draft SAP.
SAP_RECEPCION_PREVIEW_ENABLED=False 

# =============================
# HANA READ ONLY - independiente de SAP_ENVIRONMENT
# =============================
# Puede leer produccion aunque SAP_ENVIRONMENT=QA.
SAP_HANA_SERVER_ADDRESS=COLOCAR_HOST_HANA_LECTURA
SAP_HANA_SERVER_PORT=30015
SAP_HANA_COMPANY_DB=COLOCAR_COMPANY_DB_HANA_LECTURA
SAP_HANA_CLIENTES_COMPANY_DB=COLOCAR_COMPANY_DB_HANA_CLIENTES
SAP_HANA_ACUERDOS_COMPANY_DB=COLOCAR_COMPANY_DB_HANA_ACUERDOS
SAP_HANA_DB_USERNAME=COLOCAR_USUARIO_HANA_LECTURA
SAP_HANA_DB_PASSWORD=COLOCAR_PASSWORD_HANA_LECTURA
